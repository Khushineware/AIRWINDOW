# AirWindow Environment Configuration

# Server & Intelligence (Backend)
# Google Gemini API key: Injected automatically by AI Studio at runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenAQ API Key (Optional): Free API key from openaq.org for nearby ground stations calibration.
# If missing, AirWindow smoothly falls back to uncorrected CAMS atmospheric forecast.
OPENAQ_API_KEY=""

# Server Port (default 3000)
PORT="3000"

# Frontend Configuration
# UI Development Fixture Toggle (UI dev ONLY - shows permanent "SAMPLE DATA" ribbon, default false)
VITE_USE_FIXTURES="false"

# API Base URL: defaults to '/api' for same-origin full-stack Express server
VITE_API_BASE_URL="/api"
